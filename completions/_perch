#compdef perch

_perch() {
  local -a subcommands worktree_subs
  subcommands=(
    'br:Check a branch out here'
    'wt:Worktree commands'
  )
  worktree_subs=(
    'ls:List worktrees'
    'rm:Remove worktree (also deletes branch)'
  )

  local branches
  branches=(${(f)"$(git branch --format='%(refname:short)' 2>/dev/null)"})

  if (( CURRENT == 2 )); then
    _describe -t subcommands 'subcommand' subcommands
    _describe -t branches 'branch' branches
  elif (( CURRENT == 3 )) && [[ "$words[2]" == wt ]]; then
    _describe -t subcommands 'worktree subcommand' worktree_subs
    _describe -t branches 'branch' branches
  elif (( CURRENT == 4 )) && [[ "$words[2]" == wt && "$words[3]" == rm ]]; then
    _describe -t branches 'branch' branches
  else
    _describe -t branches 'branch' branches
  fi
}

_perch "$@"
